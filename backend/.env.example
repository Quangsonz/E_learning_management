# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to backend/.env and update values
# ==========================================

# Server Port and Runtime
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection
MONGO_URI=mongodb://localhost:27017/elearning_db

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min32chars
JWT_EXPIRES_IN=30d

# Cloudinary Storage (Images / Videos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe Payment Gateway (Backend Secrets)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# VietQR Payment Configuration
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0383888999
VIETQR_ACCOUNT_NAME=HE THONG E LEARNING
VIETQR_BANK_NAME=MBBank (Ngan hang Quan Doi)

# Nodemailer SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password

# Rate Limiting Configuration
RATE_LIMIT_MAX=500
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_WINDOW_MS=900000

# Database Seeder Configuration (Dev / Testing)
SEED_DEFAULT_PASSWORD=password123
