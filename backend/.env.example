# ==============================================================================
# BACKEND PRODUCTION & DEVELOPMENT ENVIRONMENT TEMPLATE
# For Render: Set these Key/Value pairs in Render Dashboard > Environment Variables
# For Local: Copy to backend/.env and populate with your credentials
# ==============================================================================

# --- Server & Runtime Environment ---
NODE_ENV=production
PORT=5000
# Base public URL of backend on Render (e.g. https://e-learning-backend.onrender.com)
APP_URL=https://your-backend.onrender.com

# --- Frontend CORS & Client Redirection ---
# Vercel production frontend URL (and dev fallback)
CLIENT_URL=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# --- Database Connection (MongoDB Atlas) ---
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/E-Learning?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/E-Learning?retryWrites=true&w=majority
DB_NAME=E-Learning

# --- JWT Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
JWT_EXPIRES_IN=30d

# --- Cloudinary Media Storage (Avatars, Videos, PDFs) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Stripe Payment Gateway ---
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe Webhook Secret (from Render endpoint: https://<your-backend>.onrender.com/api/payments/webhook)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# --- VietQR Payment Configuration (Optional / Bank Transfer) ---
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0383888999
VIETQR_ACCOUNT_NAME=HE THONG E LEARNING
VIETQR_BANK_NAME=MBBank (Ngan hang Quan Doi)
# Set to 'false' in production to disable unverified client mock payments
ENABLE_MOCK_PAYMENTS=false

# --- Email Service (SMTP / Gmail App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
EMAIL_FROM=noreply@elearning.com
# Backward-compatible aliases:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password

# --- API Rate Limiting ---
RATE_LIMIT_MAX=500
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_WINDOW_MS=900000

# --- Database Seeder (Dev only) ---
SEED_DEFAULT_PASSWORD=password123
