# ==========================================
# FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to frontend/.env and update values
# ==========================================

# Backend API Endpoint (Include /api)
VITE_API_URL=http://localhost:5000/api

# Real-time WebSocket Endpoint (Optional in local dev, defaults to host from VITE_API_URL)
VITE_SOCKET_URL=http://localhost:5000


